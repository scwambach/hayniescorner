<!doctype html>
<html>
  <head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= content.title.rendered %> | Haynie's Corner Arts District">
    <meta property="og:description" content="<%= content.excerpt.rendered %>">
    <meta name="description" content="<%= content.excerpt.rendered %>">
    <meta property="og:url" content="http://hayniescorner.com/">
    <meta property="og:site_name" content="Haynie's Corner Arts District">
    <meta property="og:image" content="<%= content._embedded['wp:featuredmedia'][0].media_details.sizes.medium.source_url %>">
    <meta property="og:locale" content="en_US">
    <link rel="icon" type="image/png" href='<%= data.api.settings.options.acf.favicon.url %>'>
    <title><%= content.title.rendered %> | Haynie's Corner Arts District</title>
    <%= stylesheet_link_tag "site" %>
  </head>
  <body>
    <%= partial 'partials/organisms/header' %>
    <%= partial 'partials/organisms/nav' %>
    <div class="inner-business center" style="background-image: url(<%= content._embedded['wp:featuredmedia'][0].media_details.sizes.full.source_url%>)">
      <%= partial 'partials/molecules/featured-image', locals: { content: content } %>
      <div class="main-content">
        <%= partial 'partials/molecules/copy-block', locals: { content: content } %>
        <%= partial 'partials/molecules/quote', locals: { content: content } %>
        <div class="label blue">
          <div class="inner">
            <h2><%= content.acf.owner %></h2>
          </div>
        </div>
      </div>
    </div>
    <%= partial 'partials/organisms/footer' %>
  </body>
  <%= javascript_include_tag "site" %>
</html>
