<!doctype html>
<html>
  <head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta property="og:type" content="website">
    <meta property="og:title" content="Home">
    <meta property="og:description" content="Adjacent to the Ohio River in downtown Evansville Indiana, a creative community of 4 neighborhoods define the Arts District.">
    <meta name="description" content="Adjacent to the Ohio River in downtown Evansville Indiana, a creative community of 4 neighborhoods define the Arts District.">
    <meta property="og:url" content="http://hayniescorner.com/">
    <meta property="og:site_name" content="Haynie's Corner Arts District">
    <meta property="og:image" content="<%= data.api.pages.home._embedded['wp:featuredmedia'][0].media_details.sizes.medium.source_url %>">
    <meta property="og:locale" content="en_US">
    <link rel="icon" type="image/png" href='<%= data.api.settings.options.acf.favicon.url %>'>
    <title>Haynie's Corner Arts District</title>
    <%= stylesheet_link_tag "site" %>
  </head>
  <body>
    <%= partial 'partials/organisms/header' %>
    <%= partial 'partials/organisms/nav' %>
    <% content = data.api.pages.home %>
    <%= partial 'partials/organisms/hero', locals: { content: content } %>
    <% content.acf.page_sections.each_with_index do |section, i| %>
    <section id="<%= section.section_id %>" class="widget clearfix <%= section.acf_fc_layout.gsub('_', '-') %>">
    <%= partial "partials/organisms/#{section.acf_fc_layout}", locals: { content: section } %>
    </section>
    <% end %>
    <%= partial 'partials/organisms/footer' %>
  </body>
  <%= javascript_include_tag "site" %>
</html>
