<%
busnessCount = 0
busnessId = 0

data.api.businesses.each do |business|
  if business[1]._embedded['wp:term'][0][0].slug === type
    busnessCount = busnessCount + 1
  end
end

businessCount= rand(1..busnessCount)

data.api.businesses.each do |business|
  if business[1]._embedded['wp:term'][0][0].slug === type
    busnessId = busnessId + 1
    if businessCount == busnessId
%>
      <a class="single-business" href='discover/<%= business[1].slug %>' style="background-image: url(<%= business[1]._embedded['wp:featuredmedia'][0].media_details.sizes.medium_large.source_url %>)">
        <h2><%= business[1].title.rendered %></h2>
      </a>
<%
    end
  end
end
%>
