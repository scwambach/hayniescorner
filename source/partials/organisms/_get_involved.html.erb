<div class="inner flex">
  <div class="map-container">
    <a href="https://www.google.com/search?rlz=1C5CHFA_enUS742US742&q=haynie%27s+corner+evansville&npsic=0&rflfq=1&rlha=0&rllag=37961416,-87565794,0&tbm=lcl&ved=2ahUKEwjnpKeP14HdAhWMr4MKHedeA-MQtgN6BAgCEAQ&tbs=lrf:!2m4!1e17!4m2!17m1!1e2!2m1!1e2!2m1!1e16!3sIAE,lf:1,lf_ui:1&rldoc=1#rlfi=hd:;si:;mv:!1m3!1d1906.6384560773147!2d-87.56495912757799!3d37.96204483360679!3m2!1i1483!2i931!4f13.1;tbs:lrf:!2m1!1e2!2m1!1e16!2m4!1e17!4m2!17m1!1e2!3sIAE,lf:1,lf_ui:1" target="_blank"><img src="/images/map.png" style='display: block;' width='100%'></a>
    <div class="map-key">
      <div class="inner">
        <h3><%= content.map_title %></h3>
        <ul>
          <% data.api.businesses.sort{|a,b| a[1].slug <=> a[1].slug}.each_with_index do |business, i|%>
          <li><a href="/discover/<%= business[1].slug %>/"><span><%= i+1 %>. </span> <%= business[1].title.rendered %></a></li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
  <div class="copy-container">
    <div class="content-container">
      <div class="inner">
        <h3><%= content.inv_heading %></h3>
        <%= content.inv_copy %>
      </div>
      <div class="secondary-copy">
        <div class="content content-box">
          <%= content.copy_2 %>
        </div>
      </div>
    </div>
  </div>
</div>
