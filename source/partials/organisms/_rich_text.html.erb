<div class="inner <%= content.color %> bg-image">
  <div class="floating-background" style='background-image: url(<%= content.background_image.sizes.large if content.background_image %>)'></div>
  <div class="wrap">
    <div class="content content-box <%= 'box-alt' if content.alt_box %>">
      <div class="inner">
        <%= content.content %>
      </div>
    </div>
  </div>
</div>
